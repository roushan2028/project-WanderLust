<% layout('layouts/boilerplate') %>
<body>
    <div class="row">
        <h1 class="col-6 offset-3">Login on Wanderlust</h1>
        <div class="col-8 offset-3 ">
            <form action="/login" method="POST" class="needs-validation" novalidate>
                <div class="mb-3">
                    <label for="username" class="form-label">Username</label>
                    <input
                        name="username"
                        id="username"
                        type="text"
                        class="form-control"
                        required
                    />
                </div>
                <div class="mb-3">
                    <label for="password" class="form-label">Password</label>
                    <input
                        name="password"
                        id="password"
                        type="password"
                        class="form-control"
                        required
                    />
                </div>
                <button class="btn btn-success">Login</button>
                <a href="/signup" class="btn btn-success offset-1">SignUp</a>
            </form>
        </div>
    </div>
</body>