<% if(message && message.length){ %>
    <div clas="row">
        <div class="col-6 offset-3">
            <div class="alert alert-success alert-dismissible fade show " role="alert">
                <%=message%>
                <button
                    type="button"
                    class="btn-close",
                    data-bs-dismiss="alert"
                    aria-lebel="Close"
                ></button>
            </div>
        </div>
    </div>
<% } %>

<% if(error && error.length){ %>
    <div class="row">
        <div class="col-8 offset-3">
            <div class="alert alert-danger alert-dismissible fade show col-6 offest-3" role="alert">
                <%=error%>
                <button
                    type="button"
                    class="btn-close",
                    data-bs-dismiss="alert"
                    aria-lebel="Close"
                ></button>
            </div>
        </div>
    </div>
<% } %>